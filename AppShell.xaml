<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:Class="TransporteAcademico.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:TransporteAcademico.Pages"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarForegroundColor="{StaticResource Primary}"
       Shell.TabBarUnselectedColor="Gray"
       Shell.TabBarTitleColor="{StaticResource Primary}">

    <TabBar>
        <ShellContent Title="Inicio" Icon="home.png"
                      ContentTemplate="{DataTemplate pages:HomePage}" />
        <ShellContent Title="Mapa" Icon="map.png"
                      ContentTemplate="{DataTemplate pages:MapPage}" />
        <ShellContent Title="Notificaciones" Icon="bell.png"
                      ContentTemplate="{DataTemplate pages:NotificationsPage}" />
        <ShellContent Title="Perfil" Icon="user.png"
                      ContentTemplate="{DataTemplate pages:ProfilePage}" />
    </TabBar>
</Shell>
